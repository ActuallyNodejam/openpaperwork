  {
   "id": "LOCALE-PAPER",
   "text": "The page is the locale's paper size: A4 for eu and the European and Australian entries, US Letter for us, en-US, en-CA and fr-CA."
  },
  {
   "id": "LOCALE-DATE",
   "text": "Dates are written in the locale's order: dd.MM.yyyy for eu, MM/DD/YYYY for us."
  },
  {
   "id": "LOCALE-NUMBER",
   "text": "Numbers use the locale's separators: 1.234,56 for eu, 1,234.56 for us."
  },
  {
   "id": "LOCALE-CURRENCY",
   "text": "The amount carries the locale's currency: EUR for eu, USD for us."
  }
 ]
