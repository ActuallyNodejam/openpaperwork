{
 "about": "Every key the invoice builders read from an order's data file: the page (page/build_page.py), the EN 16931 XML (scripts/einvoice_create.py) and the national files (scripts/*_create.py). The builders stop on a key that is not here, and on a value of another shape (skills/_shared/spec_guard.py). A fact with no field of its own goes in note (one line under the totals, also carried in the XML as the invoice note), or, for the seller's own particulars, in seller.further (printed in the footer with its register details).",
 "open": {"": "note", "seller": "further"},
 "hints": {
  "notes": "an invoice has one free line, \"note\" (text), printed under the totals and carried in the XML",
  "terms": "payment terms go in \"payment_terms\" (text)",
  "bank": "the bank account goes in \"payment\": {\"bank\": ..., \"iban\": ..., \"bic\": ...}",
  "iban": "the bank account goes in \"payment\": {\"bank\": ..., \"iban\": ..., \"bic\": ...}",
  "supply_date": "the date of supply is \"delivery_date\" (or \"delivery_period\": {\"from\": ..., \"to\": ...})",
  "date_of_supply": "the date of supply is \"delivery_date\" (or \"delivery_period\": {\"from\": ..., \"to\": ...})",
  "invoice_number": "the invoice number is \"number\", written exactly as the person's files give it",
  "date": "the invoice date is \"issue_date\"",
  "customer": "the customer is \"buyer\"",
  "supplier": "the supplier is \"seller\"",
  "lines.description": "a line's text is \"name\"",
  "lines.price": "a line's price is \"unit_price\", a number",
  "lines.vat": "a line's VAT rate is \"vat_rate\", a percentage written as a number (20 for 20 percent)",
  "seller.iban": "the bank account goes in the top-level \"payment\": {\"bank\": ..., \"iban\": ..., \"bic\": ...}",
  "seller.vat_number": "the VAT number is \"vat_id\"",
  "buyer.vat_number": "the VAT number is \"vat_id\""
 },
